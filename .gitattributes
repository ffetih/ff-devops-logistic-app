# Same line endings on Windows, WSL and CI.
* text=auto

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts and anything a Linux container reads keep LF
*.sh  text eol=lf
mvnw  text eol=lf
Dockerfile text eol=lf

# EDIFACT files are exchanged byte for byte
*.edi -text

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.pdf binary
*.tar binary
