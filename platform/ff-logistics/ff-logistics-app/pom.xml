<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        FF Logistics product. One database (ff_logistics), migrated by Flyway. One deployable
        made of Spring Modulith modules, one top-level package each; ModularityTest keeps them
        apart. The business modules (standards, wms, tms, geo, reporting) arrive sprint by
        sprint, see docs/backlog.md.
    -->
    <parent>
        <groupId>com.siose.ff</groupId>
        <artifactId>siose-ff-base-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../base/ff-base-parent/pom.xml</relativePath>
    </parent>

    <groupId>com.siose.ff</groupId>
    <artifactId>siose-ff-logistics-app</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Siose FF - Logistics App</name>

    <dependencies>
        <!-- Base libraries: pick only what the product needs (versions from siose-ff-base-bom) -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>siose-ff-base-tenant</artifactId>
        </dependency>
        <!-- Only auto-configuration is used, so runtime scope: no compile-time coupling -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>siose-ff-base-security</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- RFC 9457 problems; the modules throw its exceptions (not found, conflict) -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>siose-ff-base-web</artifactId>
        </dependency>
        <!-- Entities extend TenantAwareEntity: Hibernate adds tenant_id = ? to every query -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>siose-ff-base-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- JWT resource server: Boot's JwtDecoder from the identity service's JWKS -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- @ApplicationModule in each module's package-info.java, and the event publication
             registry: events between modules are written to event_publication in the
             publishing transaction (JDBC), as JSON (Jackson). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <!-- Orders longer routes and routes with time windows (geo); version from the base BOM -->
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ModularityTest: the generated diagrams (Documenter); spring-modulith-core comes with
             the starter above. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-docs</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Waiting in tests for what an event listener does on its own thread -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Most tests run on an in-memory database -->

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL 17 for FlywayMigrationTest. Version from the Spring Boot BOM (Testcontainers 2). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The jar name the Dockerfile copies, without the version -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- git.properties: /actuator/info shows which commit is running -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
